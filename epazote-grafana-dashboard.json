          "editorMode": "code",
          "expr": "epazote_ssl_cert_expiry_seconds{job=~\"$job\", ip=~\"$ip\"}",
          "legendFormat": "{{service_name}} ({{ip}})",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "SSL Cert Expiration",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Age of the most recent completed check per service.\n\n**WHAT TO LOOK FOR:**\n- A value growing without bound = that service's monitoring task has stopped ticking. `epazote_status` keeps publishing its last value indefinitely, so a stalled check looks identical to a healthy one there\n- A steady sawtooth peaking near the service's `every` interval = normal\n\n**NOTE:** unlike the other fallback metrics this one is not seeded at start-up, because a zero would claim a check happened at the Unix epoch and trip any staleness alert immediately. A service therefore has no series here until its first check completes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "id": 8,
